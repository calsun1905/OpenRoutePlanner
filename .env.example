# OpenRoutePlanner environment variables example
# Copy this file as .env and fill required API keys.
# Windows: copy .env.example .env
# Linux/macOS: cp .env.example .env

# -----------------------------
# Logging
# -----------------------------
ORP_LOG_FORCE_PRINT_FLUSH=1

# -----------------------------
# BERT runtime
# -----------------------------
ORP_BERT_PRELOAD_ON_STARTUP=1
ORP_BERT_LOG_METRICS=1
ORP_BERT_METRICS_INTERVAL_SEC=0.5
ORP_BERT_PARSE_TRACE=1

# -----------------------------
# BERT place seed sources
# -----------------------------
ORP_BERT_SEED_STATIC=1
ORP_BERT_SEED_DYNAMIC=1
ORP_BERT_SEED_USER_LOCATIONS=1
ORP_BERT_SEED_LOCAL=1

# -----------------------------
# OSM / Nominatim behavior
# -----------------------------
ORP_BERT_USE_OSM=0
ORP_BERT_PREFER_OSM_FIRST=0
ORP_BERT_OSM_TIMEOUT_SEC=3.0
ORP_BERT_OSM_PREFETCH_BUDGET_SEC=2.5
ORP_BERT_OSM_PREFETCH_MAX_QUERIES=3

# -----------------------------
# POI resolver / cache pin
# -----------------------------
ORP_POI_DICT_VERSION=dict-v1
ORP_POI_THRESHOLD_PROFILE=default
ORP_POI_PLAN_VERSION=phase2
ORP_TRACE_RETENTION_DAYS=14

# -----------------------------
# OpenRouter (chat)
# -----------------------------
OPENROUTER_API_KEY=or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=arcee-ai/trinity-mini:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,stepfun/step-3.5-flash:free
ORP_OPENROUTER_TIMEOUT_SEC=45
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=OpenRoutePlanner
OPENROUTER_SYSTEM_PROMPT=

# -----------------------------
# Google Gemini (optional)
# -----------------------------
GEMINI_API_KEY=
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-1.5-flash,gemini-1.5-pro,gemini-2.5-flash-lite
ORP_GEMINI_TIMEOUT_SEC=60
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# -----------------------------
# Local LLM (optional)
# -----------------------------
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=local-qwen35
LOCAL_LLM_FALLBACK_MODELS=
LOCAL_LLM_SYSTEM_PROMPT=

# -----------------------------
# RAG / NLP extra settings (optional)
# -----------------------------
ORP_RAG_DB_PATH=
ORP_RAG_COLLECTION=istanbul_rag_core
ORP_RAG_EMBED_MODEL=BAAI/bge-m3
ORP_INTENT_TEMPLATE_PATH=
ORP_NLP_AUDIT_RETENTION_DAYS=21
ORP_LLM_COOLDOWN_SECONDS=900
ORP_LLM_FAILURE_THRESHOLD=3

# -----------------------------
# Runtime behavior
# -----------------------------
ORP_AUTO_LOAD_DOTENV=1
