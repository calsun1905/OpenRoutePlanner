# OpenRoutePlanner environment variables example
# Copy this file as .env and fill OPENROUTER_API_KEY (sohbet icin).
# Gemini dogrudan API: istege bagli GEMINI_API_KEY veya GOOGLE_API_KEY.
# Windows: copy .env.example .env
# Linux/macOS: cp .env.example .env

# -----------------------------
# Logging
# -----------------------------
ORP_LOG_FORCE_PRINT_FLUSH=1

# -----------------------------
# BERT runtime
# -----------------------------
ORP_BERT_PRELOAD_ON_STARTUP=1
ORP_BERT_LOG_METRICS=1
ORP_BERT_METRICS_INTERVAL_SEC=0.5
ORP_BERT_PARSE_TRACE=1

# -----------------------------
# BERT place seed sources
# -----------------------------
ORP_BERT_SEED_STATIC=1
ORP_BERT_SEED_DYNAMIC=1
ORP_BERT_SEED_USER_LOCATIONS=1
ORP_BERT_SEED_LOCAL=1

# -----------------------------
# OSM / Nominatim behavior
# -----------------------------
ORP_BERT_USE_OSM=0
ORP_BERT_PREFER_OSM_FIRST=0

# OSM-first guard settings
ORP_BERT_OSM_TIMEOUT_SEC=3.0
ORP_BERT_OSM_PREFETCH_BUDGET_SEC=2.5
ORP_BERT_OSM_PREFETCH_MAX_QUERIES=3

# -----------------------------
# POI resolver / cache pin
# -----------------------------
ORP_POI_DICT_VERSION=dict-v1
ORP_POI_THRESHOLD_PROFILE=default
ORP_POI_PLAN_VERSION=phase2
ORP_TRACE_RETENTION_DAYS=14

# -----------------------------
# OpenRouter (required for chat)
# IMPORTANT:
# - Write model SLUGs, not URLs.
# - Example slug: google/gemma-3-27b-it:free
# -----------------------------
OPENROUTER_API_KEY=or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=arcee-ai/trinity-mini:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,stepfun/step-3.5-flash:free,nvidia/nemotron-3-nano-30b-a3b:free,google/gemma-3-12b-it:free,nvidia/nemotron-nano-9b-v2:free,liquid/lfm-2.5-1.2b-thinking:free,liquid/lfm-2.5-1.2b-instruct:free,nousresearch/hermes-3-llama-3.1-405b:free,minimax/minimax-m2.5:free,meta-llama/llama-3.2-3b-instruct:free,meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free,google/gemma-3n-e2b-it:free,google/gemma-3n-e4b-it:free,google/gemma-3-4b-it:free,qwen/qwen3-coder:free,qwen/qwen3-next-80b-a3b-instruct:free,openai/gpt-oss-20b:free,openai/gpt-oss-120b:free,z-ai/glm-4.5-air:free,cognitivecomputations/dolphin-mistral-24b-venice-edition:free,mistralai/mistral-small-3.1-24b-instruct:free,qwen/qwen3-4b:free
ORP_OPENROUTER_TIMEOUT_SEC=45

# Optional attribution headers
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=OpenRoutePlanner

# -----------------------------
# Google Gemini (dogrudan Gemini API — panelde "Gemini" secenegi)
# -----------------------------
# Anahtar: https://aistudio.google.com/apikey
# Iki isimden biri yeterli; ikisi de varsa GEMINI_API_KEY onceliklidir.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Varsayilan model ve fallback sirasi (virgulle); kota/limitte sonrakine gecilir.
# 2.0 beta: cogu hesapta gemini-2.0-flash-exp kullanin; stabil icin gemini-2.5-flash veya 1.5.
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-1.5-flash,gemini-1.5-pro,gemini-2.5-flash-lite
ORP_GEMINI_TIMEOUT_SEC=60
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

ssssss