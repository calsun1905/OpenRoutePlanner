venv/
.venv/
__pycache__/
*.pyc
*.pyo
backend/data/*.graphml
backend/data/saved_routes.json
backend/data/saved_locations.json
backend/data/app_data.db
backend/data/pois.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/_test_result.json
.coverage
.env
*.log

# indirilen yapay zeka modelleri
backend/models/*
!backend/models/.gitkeep
!backend/models/bert-base-turkish-uncased/
backend/models/bert-base-turkish-uncased/*
!backend/models/bert-base-turkish-uncased/.gitkeep

# Ortak cache klasoru: varsayilan olarak ignore.
# Repoda tutmak istenen dosyalar icin asagiya ! ile istisna ekleyin (or. geocodes.db).
/cache/
backend/cache/*
!backend/cache/.gitkeep
!backend/cache/*.db
!backend/cache/osrm_shards/
!backend/cache/osrm_shards/**/
!backend/cache/osrm_shards/**/*.db
backend/cache/*.local.db
backend/cache/*.db-wal
backend/cache/*.db-shm
backend/cache/osrm_shards/**/*.db-wal
backend/cache/osrm_shards/**/*.db-shm
# !backend/cache/*.json
backend/*.pid

# Geçici debug çıktıları
scripts/debug/

# Local tooling artifacts
.bg-shell/
.claude/settings.local.json
.serena/
tmp_buttons.html
claude-mem-*.tgz
